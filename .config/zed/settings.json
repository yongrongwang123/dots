{
  "search": {
    "button": false
  },
  "diagnostics": {
    "button": false
  },
  "buffer_line_height": "standard",
  "agent_ui_font_size": 15.0,
  "ui_font_size": 15.0,
  "seed_search_query_from_cursor": "never",
  "debugger": {
    "button": false,
    "dock": "left"
  },
  "terminal": {
    "dock": "left"
  },
  "zoomed_padding": false,
  "inline_code_actions": false,
  "horizontal_scroll_margin": 0.0,
  "vertical_scroll_margin": 0.0,
  "git_panel": {
    "tree_view": true
  },
  "format_on_save": "off",
  "cursor_blink": false,
  "disable_ai": true,
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },
  "agent": {
    "button": false,
    "favorite_models": [],
    "model_parameters": []
  },
  "collaboration_panel": {
    "dock": "left",
    "button": false
  },
  "outline_panel": {
    "button": false,
    "default_width": 360.0,
    "git_status": false,
    "indent_guides": {
      "show": "never"
    }
  },
  "project_panel": {
    "starts_open": false,
    "sticky_scroll": false,
    "default_width": 360.0,
    "entry_spacing": "standard",
    "indent_guides": {
      "show": "never"
    },
    "git_status": false
  },
  "tab_bar": {
    "show_tab_bar_buttons": false,
    "show_nav_history_buttons": false
  },
  "title_bar": {
    "show_worktree_name": false,
    "show_user_picture": false,
    "show_user_menu": false,
    "show_sign_in": false,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false
  },
  "status_bar": {
    "active_language_button": false,
    "show_active_file": true
  },
  "indent_guides": {
    "enabled": false
  },
  "toolbar": {
    "agent_review": false,
    "selections_menu": false,
    "quick_actions": false,
    "breadcrumbs": false
